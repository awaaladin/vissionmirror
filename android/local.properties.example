# Copy to local.properties (git-ignored) and adjust.
sdk.dir=C\:\Users\YOU\AppData\Local\Android\Sdk
# Optional. Leave this out to use the live server (https://visionmirror-api.vercel.app/), which is what you want on
# a real phone. Only to test a server running on your PC: the emulator reaches it at http://10.0.2.2:8000/,
# a real phone needs your PC's LAN address. Trailing slash required.
# API_BASE_URL=http://10.0.2.2:8000/
# Release builds always use this (must be https://). Defaults to the production backend.
API_BASE_URL_RELEASE=https://visionmirror-api.vercel.app/
