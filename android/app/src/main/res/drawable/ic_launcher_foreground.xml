<?xml version="1.0" encoding="utf-8"?>
<!-- VisionMirror mark: a glowing mirror oval (brass to champagne) carrying the assistant's voice as three arcs.
     Everything sits inside the 66 dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft glow behind the glass -->
    <path
        android:pathData="M54,24 C67.8,24 79,37.6 79,54 C79,70.4 67.8,84 54,84 C40.2,84 29,70.4 29,54 C29,37.6 40.2,24 54,24 z"
        android:fillColor="#26E0A458" />

    <!-- The mirror -->
    <path android:pathData="M54,27 C65.6,27 75,39.1 75,54 C75,68.9 65.6,81 54,81 C42.4,81 33,68.9 33,54 C33,39.1 42.4,27 54,27 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="27"
                android:endX="54" android:endY="81"
                android:type="linear">
                <item android:offset="0" android:color="#F5D9A0" />
                <item android:offset="1" android:color="#E0A458" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight on the glass -->
    <path
        android:pathData="M43,45 C43.6,39.4 47.2,35.4 52.4,33.8"
        android:strokeColor="#CCFFF6E2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- The voice: three arcs, the middle one in rose quartz -->
    <path
        android:pathData="M50.1,48.9 A8,8 0 0 1 50.1,59.1"
        android:strokeColor="#0C0D10"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54.3,45.3 A13.5,13.5 0 0 1 54.3,62.7"
        android:strokeColor="#F2A8B8"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58.6,41.8 A19,19 0 0 1 58.6,66.2"
        android:strokeColor="#0C0D10"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
