# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

REDIS_URL=redis://localhost:6379/0

# mock = canned output, no API calls. anthropic or gemini = real AI.
VISION_PROVIDER=mock
# Optional: force one mock scenario: outfit | stain | clash | dark
MOCK_SCENARIO=

# Only needed when VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5

# Free alternative: VISION_PROVIDER=gemini with a key from https://aistudio.google.com/apikey
# NOTE: Google's free tier may use submitted photos to improve its products. Use the paid tier for real users.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# minimal|low|medium|high. 'low' answers in ~5s but missed an obvious stain in testing; 'medium' takes ~12-15s and caught it.
GEMINI_THINKING_LEVEL=medium
# Thinking depth: low (fastest/cheapest) | medium | high. Compare on real photos before changing.
VISION_EFFORT=medium

TOKEN_TTL_SECONDS=86400
SESSION_TTL_SECONDS=600
MAX_IMAGE_BYTES=5242880

# --- Abuse protection (Phase 3). Requests per minute, applied per device AND per IP. ---
RATE_GENERAL_DEVICE_PER_MIN=60
RATE_GENERAL_IP_PER_MIN=120
RATE_DESCRIBE_DEVICE_PER_MIN=6
RATE_DESCRIBE_IP_PER_MIN=20
RATE_ASK_DEVICE_PER_MIN=20
RATE_ASK_IP_PER_MIN=60
RATE_AUTH_IP_PER_MIN=20
# Global cap on AI calls (describe + ask) per UTC day. 0 blocks all AI calls.
DAILY_AI_CALL_LIMIT=500
# Exact browser origins allowed by CORS, comma-separated. Empty = none (native apps don't need CORS). No "*".
CORS_ORIGINS=http://localhost:5173
# Set true ONLY behind a proxy you control (Render/Railway/Fly), so the real client IP is used for limits.
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
